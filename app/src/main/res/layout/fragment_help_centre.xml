<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/start_screen_gradient"
    tools:context=".InApp.HelpCentreFragment">

    <!-- Back Button -->
    <ImageButton
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:paddingLeft="6dp"
        android:background="@drawable/back_button_shape"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title/Header -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginTop="32dp"
        android:text="Help center"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sub-header -->
    <TextView
        android:id="@+id/issueTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:text="I have an issue with"
        android:textSize="20sp"
        android:textColor="#0EBE7F"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTitle" />

    <!-- LinearLayout for List Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/issueTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Menu Items -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking a new Appointment"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:padding="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Existing Appointment"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:padding="16dp"
            android:clickable="true"

            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Online consultations"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:padding="16dp"
            android:clickable="true"

            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feedbacks"
            android:textSize="18sp"
            android:clickable="true"

            android:textColor="@color/black"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medicine orders"
            android:textSize="18sp"
            android:clickable="true"

            android:textColor="@color/black"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagnostic Tests"
            android:textSize="18sp"
            android:clickable="true"

            android:textColor="@color/black"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health plans"
            android:textSize="18sp"
            android:clickable="true"

            android:textColor="@color/black"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My account and Practo Drive"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Have a feature in mind"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:padding="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:clickable="true"
            android:layout_height="wrap_content"
            android:text="Other issues"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
