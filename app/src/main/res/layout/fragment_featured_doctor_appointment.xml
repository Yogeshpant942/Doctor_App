<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/start_screen_gradient"
    tools:context=".InApp.FeaturedDoctorAppointmentFragment">

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/back_button_shape"
        android:paddingLeft="6dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="35dp"
        android:text="Appointment"
        android:textSize="29sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imageButton"
        app:layout_constraintTop_toTopOf="parent" />



    <LinearLayout
        android:id="@+id/LL1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView5">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            app:cardElevation="10dp"
            app:cardCornerRadius="8dp"
            xmlns:android="http://schemas.android.com/apk/res/android">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- Doctor Image -->
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/cartoon_image"
                        android:contentDescription="Doctor Image"
                        android:layout_gravity="center_vertical"
                        android:scaleType="centerCrop" />

                    <!-- Details Section -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Name"
                            android:id="@+id/name"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                        <TextView
                            android:id="@+id/work"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Work"
                            android:textSize="14sp"
                            android:textColor="#757575" />

                        <!-- Stars and Price -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical">

                            <RatingBar
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:numStars="5"
                                android:rating="4"
                                android:stepSize="0.5"
                                android:isIndicator="true"
                                android:layout_marginEnd="8dp"
                                style="?android:attr/ratingBarStyleSmall" />

                            <TextView
                                android:id="@+id/price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$20.00/hr"
                                android:layout_marginLeft="50dp"
                                android:textSize="14sp"
                                android:textColor="#008000"
                                android:layout_gravity="center_vertical" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Heart Button -->
                    <ImageButton
                        android:id="@+id/like_button"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/star_shape_button"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Like Button" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LL2"
        android:layout_marginTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/LL1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:text="Appointment For"
            android:textSize="24dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/PetientName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/text_bg"
            android:hint="Petient Name"
            android:paddingStart="20sp" />

        <EditText
            android:id="@+id/PetientContactNo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/text_bg"
            android:hint="Contact"
            android:inputType="numberPassword"
            android:paddingStart="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="wrap_content"
            android:id="@+id/next"
            android:layout_height="wrap_content"
            android:background="@drawable/next_button_bg"
            android:layout_marginTop="29dp"
            android:layout_marginLeft="150dp"
            android:text="Next"
            android:textColor="@color/white"/>


    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/LL2"
        app:menu="@menu/menu" />




</androidx.constraintlayout.widget.ConstraintLayout>
